# ===================================================
# WearWise Backend Environment Configuration
# ===================================================

# Security
SECRET_KEY=generate_a_random_secure_secret_key_here

# AI Models (Vision & AI Stylist Chat)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
SERPAPI_API_KEY=your_serpapi_api_key_here

# Database Configuration (PostgreSQL for Vercel/Supabase/Neon)
# Example: postgresql://postgres:password@db.supabase.co:5432/postgres
DATABASE_URL=

# CORS Configuration (Comma-separated list of allowed frontend URLs)
# Vercel deployments (*.vercel.app) and localhost are automatically allowed.
ALLOWED_ORIGINS=https://your-wearwise-app.vercel.app
