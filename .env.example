# ===================================================
# WearWise - Environment Configuration
# ===================================================

# 1. AI API Keys (Required for Vision & AI Stylist Chat)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# 2. Authentication & Security (Required)
SECRET_KEY=generate_a_random_secure_secret_key_here

# 3. Database (Recommended for permanent production data)
# Free PostgreSQL options: Supabase (supabase.com) or Neon (neon.tech)
# Example: postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Leave blank for local/demo SQLite fallback:
DATABASE_URL=

# 4. Frontend Configuration (Optional)
# In single-project Vercel monorepo, leave empty for same-origin routing.
# In split deployment, set this to your backend's deployed URL.
NEXT_PUBLIC_API_URL=

# 5. CORS Origins (Optional)
# Vercel preview/production domains (*.vercel.app) and localhost are allowed automatically.
ALLOWED_ORIGINS=https://wearwise.vercel.app
