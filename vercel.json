{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/auth/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/users/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/wardrobe/upload",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/wardrobe/analyze",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/wardrobe/analyze-url",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/wardrobe/:id(\\d+)(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/outfits/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/stylist/chat",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/stylist/status",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/stylist/api-key",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/stylist/engines",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/weather/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/uploads/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/docs",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/openapi.json",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
